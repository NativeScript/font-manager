<?xml version="1.0" encoding="utf-8"?>
<!--
  NativeScript.FontManager NuGet - MSBuild integration for C++/WinRT consumers.

  Pulled in automatically by <PackageReference Include="NativeScript.FontManager" /> from a native
  (C++) project. It adds the .winmd as a reference so cppwinrt generates the projection (the
  consumer can #include <winrt/NativeScript.FontManager.h> and call FontFace / FontFaceSet, etc.),
  then imports ../NativeScript.FontManager.Runtime.targets, which copies the active-architecture
  .dll (+ .winmd) to the build output and registers the runtimeclasses in the consuming app's
  Package.appxmanifest. Other project types get build/NativeScript.FontManager.targets instead.

  Layout inside the package:
    build/NativeScript.FontManager.Runtime.targets       (copy + registration, shared)
    build/NativeScript.FontManager.targets               (non-native consumers)
    build/native/NativeScript.FontManager.targets        (this file)
    build/native/NativeScript.FontManager.winmd          (arch-neutral metadata)
    runtimes/win10-{x64,arm64}/native/NativeScript.FontManager.dll
-->
<Project>
  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)NativeScript.FontManager.winmd">
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\NativeScript.FontManager.Runtime.targets" Condition="'$(_NSFontManagerRuntimeImported)' != 'true'" />
</Project>
